# Copy to ~/.config/omarchy/espn-fantasy.env and chmod 600.
#
#   install -m 600 example.env ~/.config/omarchy/espn-fantasy.env
#
# Only LEAGUE_ID and TEAM_ID are required for a public league.

LEAGUE_ID=
TEAM_ID=

# Defaults to the current NFL season year (rolls over in March).
#SEASON=2026

# PRIVATE LEAGUES ONLY. Leave both blank for a public league — the plugin
# sends no cookies at all when they are empty, which is what you want.
#
# Grab them from a logged-in espn.com tab: DevTools > Application > Cookies.
# They expire roughly annually; when the widget starts reporting "auth", that
# is what happened. Keep this file 600 and out of version control.
#ESPN_S2=
#SWID=
